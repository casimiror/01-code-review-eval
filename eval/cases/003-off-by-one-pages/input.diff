--- a/app/pagination.py
+++ b/app/pagination.py
@@ -2,3 +2,8 @@ def paginate(items: list, page: int, per_page: int = 20) -> list:
     """Return the items for a 1-indexed page."""
     start = (page - 1) * per_page
     return items[start : start + per_page]
+
+
+def total_pages(count: int, per_page: int = 20) -> int:
+    """Number of pages needed to show `count` items."""
+    return count // per_page
